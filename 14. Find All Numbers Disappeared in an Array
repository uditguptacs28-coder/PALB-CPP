class Solution {
public:
    vector<int> findDisappearedNumbers(vector<int>& nums) {
        int n = nums.size();
        
        for (int i = 0; i < n; i++) {
            int idx = abs(nums[i]) - 1; // map value to index
            if (nums[idx] > 0) {
                nums[idx] = -nums[idx]; // mark as seen
            }
        }
        
        vector<int> result;
        for (int i = 0; i < n; i++) {
            if (nums[i] > 0) {
                result.push_back(i + 1); // value (i+1) was never marked
            }
        }
        return result;
    }
};
