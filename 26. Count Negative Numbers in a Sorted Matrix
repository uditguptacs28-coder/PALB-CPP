class Solution {
public:
    int countNegatives(vector<vector<int>>& grid) {
        int m = grid.size();
        int n = grid[0].size();
        
        int row = 0, col = n - 1;
        int count = 0;
        
        while (row < m && col >= 0) {
            if (grid[row][col] < 0) {
                count += (col + 1); // everything left in this row is also negative
                row++;
            } else {
                col--;
            }
        }
        return count;
    }
};
