class Solution {
public:
    int projectionArea(vector<vector<int>>& grid) {
        int n = grid.size();
        int area = 0;
        
        for (int i = 0; i < n; i++) {
            int rowMax = 0, colMax = 0;
            for (int j = 0; j < n; j++) {
                if (grid[i][j] > 0) area++; // top view: count non-empty cells
                rowMax = max(rowMax, grid[i][j]);   // front view (xz-plane)
                colMax = max(colMax, grid[j][i]);   // side view (yz-plane)
            }
            area += rowMax + colMax;
        }
        return area;
    }
};
